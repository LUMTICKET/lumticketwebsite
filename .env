# API the site proxies to (default is the production API)
LUMTICKET_API_URL=https://api.lumticket.com

# Ticket emails (optional — without these, checkout still works and shows the reference on screen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sender@example.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=Lumticket <sender@example.com>
